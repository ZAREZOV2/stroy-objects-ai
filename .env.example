# PostgreSQL (docker compose)
POSTGRES_USER=stroy
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=stroy_db

# База данных (локальная разработка)
DATABASE_URL=postgresql+asyncpg://stroy:change-me-in-production@localhost:5432/stroy_db
DATABASE_URL_SYNC=postgresql://stroy:change-me-in-production@localhost:5432/stroy_db

# Ollama (локальные модели на CPU; см. docs/DEPLOY.md)
OLLAMA_BASE_URL=http://localhost:11434
# Требует Ollama >= 0.34.1 (образ ollama/ollama:0.34.1 в docker-compose)
OLLAMA_CHAT_MODEL=SparkLLM/Spark-X2.5-1.7B
# Опционально более качественный, но тяжелее по RAM: SparkLLM/Spark-X2.5-4B
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIMENSIONS=1024
OLLAMA_NUM_CTX=1536
# Оставляет место для ответа в num_ctx=1536 (~500–700 токенов контекста + ответ)
RAG_MAX_CONTEXT_CHARS=2000
RAG_MAX_CHUNK_CHARS_FOR_EMBED=1500

# Приложение
APP_SECRET_KEY=change-me-in-production
DEBUG=true
